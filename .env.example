# ============================================================================
# SVGCraft — Environment Configuration Example
# Copy this file to .env and fill in your values. NEVER commit .env to Git!
# ============================================================================

# Cloudflare R2 S3 API Configuration
R2_ENDPOINT=https://<YOUR_CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=svg-icon
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: Public Custom Domain or r2.dev URL mapped to the `svg-icon` bucket
# Example: https://icons.svgcraft.dev or https://pub-xxxxxxxxxxxxxxxx.r2.dev
# If left empty on Vercel, SVGCraft automatically proxies & caches SVGs from R2 via Edge Cache!
R2_PUBLIC_URL=

# Free Tier Hard Quota Guards (Auto Circuit-Breaker)
# Storage limit: 8.5 GB default (Cloudflare R2 Free Tier is 10 GB/month)
R2_MAX_STORAGE_BYTES=9126805504
# Class A Operations limit (PutObject/Write): 800,000/month default (Free Tier is 1,000,000/month)
R2_MAX_CLASS_A_PER_MONTH=800000
# Class B Operations limit (GetObject/Read via Server Proxy): 8,500,000/month default (Free Tier is 10,000,000/month)
R2_MAX_CLASS_B_PER_MONTH=8500000
