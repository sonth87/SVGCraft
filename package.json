{
  "name": "svgcraft",
  "version": "2.0.0",
  "private": true,
  "description": "SVGCraft — Next.js App Router Vector Icon Library, Inspector, Code Studio & Cloudflare R2 Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@svg-hub/web run dev",
    "build": "npm --workspace=@svg-hub/web run build",
    "start": "npm --workspace=@svg-hub/web run start",
    "start:web": "npm --workspace=@svg-hub/web run dev",
    "start:all": "node scripts/dev.js",
    "start:crawler": "node --max-old-space-size=8192 apps/crawler/src/server.js",
    "build:index": "node --max-old-space-size=8192 scripts/build-catalog-index.js",
    "r2:sync": "node --max-old-space-size=8192 scripts/sync-to-r2.js",
    "r2:sync:allsvgicons": "node --max-old-space-size=8192 scripts/sync-to-r2.js --site=allsvgicons",
    "r2:dry-run": "node --max-old-space-size=8192 scripts/sync-to-r2.js --dry-run"
  },
  "dependencies": {
    "express": "^4.21.2",
    "next": "^14.2.35",
    "playwright-core": "^1.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
