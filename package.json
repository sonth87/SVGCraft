{
  "name": "svgcraft",
  "version": "2.0.0",
  "private": true,
  "description": "SVGCraft — Next.js App Router Vector Icon Library, Inspector, Code Studio & Cloudflare R2 Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@svg-hub/web run dev",
    "build": "npm --workspace=@svg-hub/web run build",
    "start": "npm --workspace=@svg-hub/web run start",
    "start:web": "npm --workspace=@svg-hub/web run dev",
    "start:all": "node scripts/dev.js",
    "start:crawler": "node --max-old-space-size=8192 apps/crawler/src/server.js",
    "build:index": "tsx scripts/build-catalog-index.ts",
    "publish": "node --max-old-space-size=8192 --import tsx scripts/publish.ts",
    "lint": "npm --workspace=@svg-hub/web run lint",
    "typecheck": "npm --workspace=@svg-hub/web run typecheck && npm --workspace=@svg-hub/svg-tools run typecheck && npm --workspace=@svg-hub/catalog run typecheck && tsc --noEmit -p scripts",
    "test": "vitest run",
    "format": "prettier --no-error-on-unmatched-pattern --write \"packages/svg-tools/**/*.ts\" \"packages/catalog/**/*.ts\" \"scripts/**/*.ts\" \"apps/web/src/**/*.{ts,tsx}\" \"docs/**/*.md\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"packages/svg-tools/**/*.ts\" \"packages/catalog/**/*.ts\" \"scripts/**/*.ts\" \"apps/web/src/**/*.{ts,tsx}\" \"docs/**/*.md\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "next": "^14.2.35",
    "playwright-core": "^1.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
